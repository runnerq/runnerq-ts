{
  "name": "runnerq",
  "version": "0.1.0",
  "description": "Durable TypeScript functions, with pluggable storage",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.js"
    },
    "./conductor": {
      "types": "./dist/conductor/index.d.ts",
      "import": "./dist/conductor/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run typecheck && node --test test/*.test.mjs",
    "test:integration": "npm run build && npm run typecheck && node scripts/test-integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:gen": "go run -C spec ./tools/gen -lang ts -out ../src/spec.ts && go run -C spec ./tools/gen -lang ts -part schema -out ../src/spec-schema.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "superjson": "2.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  },
  "license": "MIT"
}
